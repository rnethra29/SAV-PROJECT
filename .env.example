# ============================================================
# SAV ERP - Commercial Lifecycle Module - environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Direct Postgres connection to your Supabase project (Settings > Database >
# Connection string > URI). Used for all transactional SQL / views / CTEs.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Supabase project settings (Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# New-format keys (Settings > API > API Keys) - preferred
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# New projects verify Auth tokens via JWKS (asymmetric signing) instead of a shared secret
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Legacy-format equivalents (only needed if your project still uses them instead of the above)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase Storage bucket for com_documents (private bucket - see src/services/document.service.js)
DOCUMENTS_BUCKET=com-documents
SIGNED_URL_EXPIRY_SECONDS=300

# Optional: only needed for app-issued service tokens (internal scripts/cron), independent of Supabase Auth
JWT_SECRET=
JWT_EXPIRES_IN=1d

CORS_ORIGIN=*
LOG_LEVEL=info

# Optional: used only by `npm run seed` if no rows exist yet in `users`
SEED_USER_ID=
