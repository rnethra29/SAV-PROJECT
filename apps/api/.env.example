# Copy to .env and fill in real values. Never commit .env.

# Runtime
NODE_ENV=development
PORT=4000

# Allowed origin(s) for CORS - comma-separated for multiple
CORS_ORIGIN=http://localhost:3000

# Database (Prisma / PostgreSQL via Supabase)
# No schema exists yet - placeholder only, do not point at a real database.
DATABASE_URL=postgresql://user:password@localhost:5432/sav_erp?schema=public

# Logging
LOG_LEVEL=info
